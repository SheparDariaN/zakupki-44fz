{
  "name": "zakupki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:postgres:up": "node --import dotenv/config ./node_modules/.bin/node-pg-migrate up --migrations-dir migrations/postgres --migration-file-language js",
    "migrate:postgres:down": "node --import dotenv/config ./node_modules/.bin/node-pg-migrate down --migrations-dir migrations/postgres --migration-file-language js",
    "migrate:mongo:up": "node --import dotenv/config ./node_modules/.bin/migrate-mongo up -f migrations/mongo/migrate-mongo-config.cjs",
    "migrate:mongo:down": "node --import dotenv/config ./node_modules/.bin/migrate-mongo down -f migrations/mongo/migrate-mongo-config.cjs",
    "migrate:up": "npm run migrate:postgres:up && npm run migrate:mongo:up",
    "migrate:down": "npm run migrate:mongo:down && npm run migrate:postgres:down",
    "import:json": "tsx scripts/import-json.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "multer": "^2.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
