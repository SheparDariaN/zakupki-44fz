# JWT_SECRET: required in production. Used to sign login tokens (24h).
JWT_SECRET="change-me-in-production"

# PostgreSQL and MongoDB are required for API storage.
POSTGRES_PASSWORD="change-me-postgres"
DATABASE_URL="postgres://zakupki:change-me-postgres@localhost:5432/zakupki"
MONGODB_URI="mongodb://localhost:27017/zakupki"

# Optional override when MONGODB_URI has no database path.
# MONGODB_DATABASE="zakupki"

# Contract files are stored on disk by purchase contract APIs.
FILE_STORAGE_DIR="./data/files"
