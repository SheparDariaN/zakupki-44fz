# GEMINI_API_KEY: leftover from AI Studio template. Not used by the app runtime.
GEMINI_API_KEY=""

# APP_URL: public URL of the app (optional; leftover from AI Studio).
APP_URL=""

# JWT_SECRET: required in production. Used to sign login tokens (24h).
JWT_SECRET="change-me-in-production"

# DB_FILE: JSON database path. Default: ./database.json
# Docker compose sets this to /app/data/database.json
# DB_FILE=./data/database.json
